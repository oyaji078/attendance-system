APP_ENV=development
APP_NAME=Campus Face Recognition Attendance System
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance

REDIS_URL=redis://redis:6379/0

INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_ALLOWED_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_MODEL_ROOT=/models/insightface
DEFAULT_DETECTION_SIZE_WIDTH=320
DEFAULT_DETECTION_SIZE_HEIGHT=320

OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_ROOT=/app/data/object-storage

COOLDOWN_SECONDS=30
HEARTBEAT_TTL_SECONDS=30
RECENT_MATCH_TTL_SECONDS=15

