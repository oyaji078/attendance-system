APP_ENV=development
APP_NAME=Campus Face Recognition Attendance System
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=attendance
POSTGRES_USER=attendance
# Wajib diubah untuk production.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

REDIS_URL=redis://127.0.0.1:6379/0

INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_ALLOWED_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_MODEL_ROOT=./models/insightface
MODEL_DIR=./models
DEFAULT_DETECTION_SIZE_WIDTH=320
DEFAULT_DETECTION_SIZE_HEIGHT=320

OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_ROOT=./data/object-storage
APP_DATA_DIR=./data

COOLDOWN_SECONDS=30
HEARTBEAT_TTL_SECONDS=30
RECENT_MATCH_TTL_SECONDS=15
ATTENDANCE_QUALITY_MODE=normal

# Wajib diubah untuk production. Gunakan nilai acak minimal 32 karakter.
AUTH_SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_32_CHARS

# Admin bootstrap — hanya digunakan untuk development.
# Di production, buat admin manual setelah deploy.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@local.test
# Wajib diubah untuk production.
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_SESSION_TTL_SECONDS=28800

# CORS — pisahkan dengan koma jika lebih dari satu origin.
# Contoh: http://localhost:8080,http://localhost:3000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate limiting login (percobaan per menit per IP)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Recognition confidence thresholds
RECOGNITION_CONFIDENCE_THRESHOLD=0.55
RECOGNITION_CANDIDATE_MARGIN_THRESHOLD=0.05
RECOGNITION_SLOW_REQUEST_MS=2500
RECOGNITION_WARMUP_ON_STARTUP=false
